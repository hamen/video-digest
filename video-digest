#!/usr/bin/env python3
"""video-digest: a daily Telegram digest of the videos I send to a bot.

  video-digest listen    long-poll the bot; queue every link that the owner sends
  video-digest process   download + transcribe (grab) and summarize (claude -p) queued links
  video-digest digest    send one Telegram message with every summary not sent yet

Config (environment, usually from ~/.config/video-digest/env):
  TELEGRAM_BOT_TOKEN   token of the digest bot (from @BotFather)
  TELEGRAM_CHAT_ID     the owner's chat: the only chat the bot listens to and writes to
  VD_STATE_DIR         state and downloads (default ~/.local/state/video-digest)
  VD_GRAB              grab command (default: grab --no-video --cookies-from-browser chrome)
  VD_SUMMARIZER        summary command, prompt on stdin (default: claude -p --model sonnet)
  TELEGRAM_API         Bot API base URL (default https://api.telegram.org; tests override it)
"""
import contextlib
import fcntl
import html
import json
import os
import re
import shlex
import subprocess
import sys
import time
import urllib.error
import urllib.request
from datetime import datetime, timezone
from pathlib import Path

URL_RE = re.compile(r"https?://[^\s<>\"']+")
MAX_ATTEMPTS = 2
TELEGRAM_LIMIT = 4096  # per message, counted in UTF-16 code units after entity parsing
SUMMARY_TIMEOUT = 300
GRAB_TIMEOUT = 1800

PROMPT = """You work for Ivan, an Android and Flutter developer with 15 years of experience who \
builds and ships a portfolio of indie mobile apps in public. Below are the metadata and the \
transcript of a short video he liked (speech-to-text, so expect misheard words and no punctuation).

Write three sections in English, with these exact marker lines. Output nothing before the first \
marker and nothing after the LinkedIn post: no notes, no checks, no comments. Everything you \
write goes straight into a Telegram message.

SUMMARY:
<one line: what the video is about, and who says it>
- <2 to 4 lines: the concrete claims, techniques or numbers from the video>
Action: <one concrete thing Ivan could try this week, or "none" if nothing applies>

X POST:
<a post for Ivan's X account, at most 270 characters, no link>

LINKEDIN POST:
<a post for Ivan's LinkedIn, 60 to 150 words, in 2 or 3 short paragraphs>

Rules for all sections:
- Use only what the transcript and metadata say. Do not invent numbers, names, quotes or claims.
- If the transcript is empty, start the summary with "No speech in this video.", summarize the \
title and description only, and write "none" for both posts.

Rules for the two posts:
- Credit the creator. Use a real name only when the title, description or uploader name states \
it; otherwise use the uploader handle with @. Never guess who speaks in a clip.
- Ivan's own angle may use only these facts: he builds and ships indie mobile apps in public, \
and he has 15 years of Android experience. Use at most one of them, in passing, and only where it \
connects to the point; never restate them as a bio line. Never invent an event, a number, a \
client, a story, a plan or a feeling about him.
- Plain, direct sentences. No em dashes, no hashtags, no emoji, no exclamation marks.
- Never use: "here's the thing", "the truth is", "let that sink in", "game changer", "unlock", \
"leverage", "delve", "journey", "it's not X, it's Y", "I keep thinking about", "the part I \
liked", a question that you answer yourself, a closing question like "Thoughts?" or "Agree?", \
one sentence per line, thread markers.
- Write "none" for both posts if the video has nothing worth sharing.

Title: {title}
Uploader: {uploader}
Duration: {duration} s
Description: {description}

Transcript:
{transcript}
"""


def log(msg):
    print(f"{datetime.now().isoformat(timespec='seconds')} {msg}", file=sys.stderr, flush=True)


def now():
    return datetime.now(timezone.utc).isoformat(timespec="seconds")


def state_dir():
    d = Path(os.environ.get("VD_STATE_DIR", Path.home() / ".local/state/video-digest"))
    d.mkdir(parents=True, exist_ok=True)
    return d


def require(name):
    value = os.environ.get(name)
    if not value:
        sys.exit(f"video-digest: {name} is not set")
    return value


# ---------------------------------------------------------------- state

@contextlib.contextmanager
def items():
    """The item list in items.json, locked for the whole block, saved on exit.

    listen, process and digest run as separate units and all write this file."""
    d = state_dir()
    with open(d / "items.lock", "w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        path = d / "items.json"
        data = json.loads(path.read_text()) if path.exists() else []
        yield data
        tmp = path.with_suffix(".tmp")
        tmp.write_text(json.dumps(data, indent=1))
        tmp.replace(path)


# ---------------------------------------------------------------- telegram

def telegram(method, http_timeout=40, **params):
    token = require("TELEGRAM_BOT_TOKEN")
    base = os.environ.get("TELEGRAM_API", "https://api.telegram.org").rstrip("/")
    req = urllib.request.Request(
        f"{base}/bot{token}/{method}", data=json.dumps(params).encode(),
        headers={"Content-Type": "application/json"})
    try:
        with urllib.request.urlopen(req, timeout=http_timeout) as resp:
            body = json.loads(resp.read())
    except urllib.error.HTTPError as e:
        body = json.loads(e.read() or b"{}")
    if not body.get("ok"):
        raise RuntimeError(f"Telegram {method}: {body.get('description', 'no description')}")
    return body["result"]


def send(text, **extra):
    return telegram("sendMessage", chat_id=require("TELEGRAM_CHAT_ID"), text=text,
                    disable_web_page_preview=True, **extra)


# ---------------------------------------------------------------- listen

def reply(msg, text):
    """Best effort: a lost "Queued" reply must not cost the link, which is already saved."""
    try:
        send(text, reply_to_message_id=msg.get("message_id"))
    except (OSError, RuntimeError, ValueError) as e:
        log(f"reply failed: {e}")


def handle_update(update, owner):
    """Queue the links in one update. Returns the number of new links.

    A storage error propagates, so listen does not ack the update and Telegram resends it."""
    msg = update.get("message") or {}
    if str(msg.get("chat", {}).get("id")) != owner:
        return 0  # only the owner's chat; strangers who find the bot get nothing
    text = " ".join(filter(None, [msg.get("text"), msg.get("caption")]))
    urls = [u.rstrip(").,") for u in URL_RE.findall(text)]
    if not urls:
        reply(msg, "Send me a video link (TikTok, Instagram, YouTube…). "
                   "It goes in tomorrow's digest.")
        return 0
    with items() as data:
        known = {i["url"] for i in data}
        new = [u for u in dict.fromkeys(urls) if u not in known]
        for u in new:
            data.append({"url": u, "received_at": now(), "status": "queued", "attempts": 0})
    if new:
        reply(msg, f"Queued {len(new)} link{'s' if len(new) > 1 else ''}.")
    else:
        reply(msg, "Already queued.")
    return len(new)


def cmd_listen(once=False):
    owner = require("TELEGRAM_CHAT_ID")
    offset_file = state_dir() / "telegram-offset"
    offset = int(offset_file.read_text()) if offset_file.exists() else 0
    log("listening")
    while True:
        try:
            # Long poll: Telegram holds the request up to 30 s; the HTTP timeout is longer.
            updates = telegram("getUpdates", http_timeout=45, offset=offset,
                               timeout=0 if once else 30, allowed_updates=["message"])
        except (OSError, RuntimeError, ValueError) as e:
            log(f"getUpdates failed: {e}")
            if once:
                return 1
            time.sleep(10)
            continue
        for update in updates:
            try:
                handle_update(update, owner)
            except (OSError, ValueError) as e:
                # The queue could not be saved. Do not ack: Telegram resends the update.
                log(f"update {update.get('update_id')} not saved, will retry: {e}")
                if once:
                    return 1
                time.sleep(10)
                break
            offset = update["update_id"] + 1
            offset_file.write_text(str(offset))
        if once:
            return 0


# ---------------------------------------------------------------- process

def summarize(folder):
    info_path = folder / "video.info.json"
    info = json.loads(info_path.read_text()) if info_path.exists() else {}
    transcript_path = folder / "transcript.txt"
    transcript = transcript_path.read_text().strip() if transcript_path.exists() else ""
    prompt = PROMPT.format(
        title=info.get("title", ""), uploader=info.get("uploader", ""),
        duration=info.get("duration", ""), description=(info.get("description") or "")[:1500],
        transcript=transcript[:60000])
    cmd = shlex.split(os.environ.get("VD_SUMMARIZER", "claude -p --model sonnet"))
    res = subprocess.run(cmd, input=prompt, capture_output=True, text=True,
                         timeout=SUMMARY_TIMEOUT)
    if res.returncode != 0 or not res.stdout.strip():
        raise RuntimeError(f"summarizer exit {res.returncode}: {res.stderr.strip()[-300:]}")
    return info, res.stdout.strip()


SECTION_RE = re.compile(r"^(SUMMARY|X POST|LINKEDIN POST):[ \t]*$", re.M)


def parse_sections(text):
    """Split the summarizer output into summary and the two post drafts.

    Output without the markers is kept whole as the summary, so a model that ignores
    the format still produces a digest entry. "none" means no draft."""
    parts = SECTION_RE.split(text)
    if len(parts) < 3:
        return {"summary": text.strip(), "x_post": "", "linkedin_post": ""}
    found = {parts[i]: parts[i + 1].strip() for i in range(1, len(parts) - 1, 2)}
    draft = lambda key: "" if found.get(key, "").lower().strip(".") in ("", "none") else found[key]
    return {"summary": found.get("SUMMARY") or text.strip(),
            "x_post": draft("X POST"), "linkedin_post": draft("LINKEDIN POST")}


def process_one(item):
    grab = shlex.split(os.environ.get("VD_GRAB", "grab --no-video --cookies-from-browser chrome"))
    out = state_dir() / "videos"
    # A hung download must not block the queue: TimeoutExpired counts as a failed attempt.
    res = subprocess.run(grab + ["-o", str(out), item["url"]], capture_output=True, text=True,
                         timeout=int(os.environ.get("VD_GRAB_TIMEOUT", GRAB_TIMEOUT)))
    lines = [l for l in res.stdout.splitlines() if l.strip()]
    if res.returncode != 0 or not lines:
        raise RuntimeError("grab failed: " + (res.stderr.strip().splitlines() or ["no output"])[-1])
    folder = Path(lines[-1])
    info, summary = summarize(folder)
    return {"folder": str(folder), "title": info.get("title") or item["url"],
            "uploader": info.get("uploader") or "", "duration": info.get("duration"),
            **parse_sections(summary)}


def cmd_process():
    with items() as data:
        pending = [i["url"] for i in data if i["status"] == "queued"]
    for url in pending:
        log(f"processing {url}")
        # Work outside the lock: grab and the summary take minutes, and listen must keep queuing.
        try:
            result, error = process_one({"url": url}), None
        except (OSError, RuntimeError, subprocess.SubprocessError, ValueError) as e:
            result, error = None, str(e)
        with items() as data:
            item = next(i for i in data if i["url"] == url)
            item["attempts"] += 1
            if result:
                item.update(result, status="done", processed_at=now())
                item.pop("error", None)
            else:
                item["error"] = error
                if item["attempts"] >= MAX_ATTEMPTS:
                    item.update(status="failed", processed_at=now())
                log(f"failed ({item['attempts']}/{MAX_ATTEMPTS}): {url}: {error}")
    return 0


# ---------------------------------------------------------------- digest

def tg_len(text):
    """Length as Telegram counts it: UTF-16 code units (an emoji counts 2)."""
    return len(text.encode("utf-16-le")) // 2


def escape_clipped(text, budget):
    """HTML-escape text, cutting the PLAIN text until the escaped form fits the budget.

    Cutting after escaping could split an entity like &amp; and make Telegram reject
    the message on every retry. The budget is generous because Telegram counts the text
    after parsing entities, so the escaped length is an upper bound."""
    out = html.escape(text, quote=False)
    while tg_len(out) > budget:
        text = text[: max(0, int(len(text) * 0.9) - 1)].rstrip() + "…"
        out = html.escape(text, quote=False)
    return out


def format_item(item):
    title = escape_clipped(item.get("title") or item["url"], 200)
    who = f" · {escape_clipped(item['uploader'], 80)}" if item.get("uploader") else ""
    url = item["url"]
    # A huge URL would not fit next to the summary; keep the title without the link then.
    head = (f'<b><a href="{html.escape(url, quote=True)}">{title}</a></b>{who}'
            if len(url) <= 300 else f"<b>{title}</b>{who}")
    if item["status"] == "failed":
        return f"{head}\n⚠️ Could not process: {escape_clipped(item.get('error') or '?', 500)}"
    block = f"{head}\n{escape_clipped(item['summary'], 1000)}"
    if item.get("x_post"):
        block += f"\n\n<b>𝕏 draft</b>\n<blockquote>{escape_clipped(item['x_post'], 450)}</blockquote>"
    if item.get("linkedin_post"):
        # Collapsed on the phone: tap to expand.
        block += ("\n<b>LinkedIn draft</b>\n<blockquote expandable>"
                  f"{escape_clipped(item['linkedin_post'], 1500)}</blockquote>")
    return block


def split_messages(header, blocks, limit=TELEGRAM_LIMIT):
    """Pack blocks into messages under the limit. Returns [(text, [block indexes])].

    format_item caps every block well under the limit, so a block is never cut."""
    packs, text, idx = [], header, []
    for n, block in enumerate(blocks):
        if idx and tg_len(text) + 2 + tg_len(block) > limit:
            packs.append((text, idx))
            text, idx = header, []
        text += "\n\n" + block
        idx.append(n)
    packs.append((text, idx))
    return packs


def cmd_digest():
    with items() as data:
        ready = [dict(i) for i in data
                 if i["status"] in ("done", "failed") and not i.get("digested_at")]
    if not ready:
        log("nothing to send")
        return 0
    day = datetime.now().strftime("%a %d %b")
    n = len(ready)
    header = f"🎬 <b>Video digest · {day}</b> · {n} video{'s' if n > 1 else ''}"
    # Send outside the lock (listen and process keep working), and stamp each message's
    # items right after Telegram accepts it: a later failure must not resend earlier parts.
    for text, idx in split_messages(header, [format_item(i) for i in ready]):
        send(text, parse_mode="HTML")
        sent_urls = {ready[k]["url"] for k in idx}
        with items() as data:
            for i in data:
                if i["url"] in sent_urls:
                    i["digested_at"] = now()
    log(f"sent {n} items")
    return 0


def main(argv):
    if len(argv) < 2 or argv[1] not in ("listen", "process", "digest"):
        print(__doc__, file=sys.stderr)
        return 2
    cmd = argv[1]
    if cmd == "listen":
        return cmd_listen(once="--once" in argv)
    return cmd_process() if cmd == "process" else cmd_digest()


if __name__ == "__main__":
    sys.exit(main(sys.argv))
